+// A date set through INT 21h AH=2Bh, kept in the file EMU2_DATE_FILE names (if set) so
+// that it outlasts this process: "YYYY MM DD". Returns 1 and fills *lt when one is set.
+static int get_set_date(struct tm *lt)
+{
+    const char *fn = getenv(ENV_DATE_FILE);
+    FILE *f;
+    int y, m, d, ok;
+    if(!fn || !(f = fopen(fn, "r")))
+        return 0;
+    ok = fscanf(f, "%d %d %d", &y, &m, &d) == 3;
+    fclose(f);
+    if(!ok)
+        return 0;
+    memset(lt, 0, sizeof(*lt));
+    lt->tm_year = y - 1900;
+    lt->tm_mon = m - 1;
+    lt->tm_mday = d;
+    lt->tm_hour = 12;
+    lt->tm_isdst = -1;
+    return mktime(lt) != (time_t)-1; // fills in tm_wday
+}
+
+static int put_set_date(unsigned y, unsigned m, unsigned d)
+{
+    const char *fn = getenv(ENV_DATE_FILE);
+    FILE *f;
+    if(!fn || y < 1980 || y > 2099 || m < 1 || m > 12 || d < 1 || d > 31)
+        return 0;
+    if(!(f = fopen(fn, "w")))
+        return 0;
+    fprintf(f, "%u %u %u\n", y, m, d);
+    fclose(f);
+    return 1;
+}
+
